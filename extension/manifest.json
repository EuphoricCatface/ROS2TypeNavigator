{
  "manifest_version": 3,
  "name": "ROS2 Type Navigator",
  "version": "0.1.0",
  "incognito": "not_allowed",
  "description": "Follow message types in ROS 2 documentation and jump to packages and interfaces.",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_title": "ROS2 Type Navigator",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://docs.ros.org/en/*"],
    "js": ["core.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "ROS2TypeNavigator@euphcat.person",
      "strict_min_version": "157.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
