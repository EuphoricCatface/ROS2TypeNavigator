{
  "manifest_version": 3,
  "name": "ROS2 Type Navigator",
  "version": "0.1.0",
  "description": "Follow message types in ROS 2 documentation and jump to packages and interfaces.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "ROS2 Type Navigator",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://docs.ros.org/en/*"],
    "js": ["core.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "ros2-type-navigator@local.invalid",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
